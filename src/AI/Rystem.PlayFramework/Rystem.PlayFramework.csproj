<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <DebugSymbols>true</DebugSymbols>
    <EmbedAllSources>true</EmbedAllSources>
    <DebugType>portable</DebugType>
    <Authors>Alessandro Rapiti</Authors>
    <Company>Alessandro Rapiti</Company>
    <Product>Rystem.PlayFramework</Product>
    <Description>Rystem.PlayFramework helps you to use concepts like multi agent and openai.</Description>
    <Copyright>2024</Copyright>
    <PackageIcon>rystem.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/KeyserDSoze/Rystem/tree/master/src/AI/Rystem.PlayFramework</RepositoryUrl>
    <PackageId>Rystem.PlayFramework</PackageId>
    <Version>10.1.0-beta.4</Version>
    <PackageReleaseNotes>Resume-summarization now preserves the active scene (populates AiSceneResponse.SceneName, DefaultSummarizer includes it in the prompt) and honors ISummarizer.ShouldSummarize, CharacterThreshold, and SceneRequestSettings.EnableSummarization. Long-term memory re-synthesis now reuses the previously loaded ConversationMemory for incremental updates. EndpointHttpTool builds URLs safely from numeric/boolean arguments (no more crash on non-string JSON). Scene routing function names are normalized for LLM provider compliance and resolved by both raw and normalized name.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
    <!-- OpenTelemetry packages -->
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Api" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
  </ItemGroup>

  <!-- ASP.NET Core framework (only loaded in ASP.NET Core apps, not in Unity/MAUI/WPF) -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Exclude example files from compilation -->
  <ItemGroup>
    <Compile Remove="Api\AUTHORIZATION_USAGE_EXAMPLE.cs" />
    <None Include="Api\AUTHORIZATION_USAGE_EXAMPLE.cs" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Services\Logging\" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>Rystem.PlayFramework.Test</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Update="Docs\RUNTIME_DESCRIPTIONS.md" Pack="true" PackagePath="Docs\RUNTIME_DESCRIPTIONS.md" />
    <None Update="Docs\FACTORY_PATTERN.md" Pack="true" PackagePath="Docs\FACTORY_PATTERN.md" />
    <None Update="Docs\DYNAMIC_CHAINING.md" Pack="true" PackagePath="Docs\DYNAMIC_CHAINING.md" />
    <None Update="Docs\CLIENT_INTERACTION_ARCHITECTURE_V2.md" Pack="true" PackagePath="Docs\CLIENT_INTERACTION_ARCHITECTURE_V2.md" />
    <None Update="Docs\TELEMETRY.md" Pack="true" PackagePath="Docs\TELEMETRY.md" />
    <None Update="Docs\RAG_INTEGRATION.md" Pack="true" PackagePath="Docs\RAG_INTEGRATION.md" />
    <None Update="Docs\MCP_INTEGRATION.md" Pack="true" PackagePath="Docs\MCP_INTEGRATION.md" />
    <None Include="rystem.png" Pack="true" PackagePath="\" />
  </ItemGroup>
    <Choose>
        <When Condition=" '$(Configuration)'=='Debug' ">
            <ItemGroup>
                <ProjectReference Include="..\..\Core\Rystem.DependencyInjection\Rystem.DependencyInjection.csproj" />
                <ProjectReference Include="..\..\Repository\RepositoryFramework.Abstractions\RepositoryFramework.Abstractions.csproj" />
            </ItemGroup>
        </When>
        <When Condition=" '$(Configuration)'!='Debug' ">
            <ItemGroup>
                <PackageReference Include="Rystem.DependencyInjection" Version="10.1.0-beta.3" />
                <PackageReference Include="Rystem.RepositoryFramework.Abstractions" Version="10.1.0-beta.3" />
            </ItemGroup>
        </When>
    </Choose>

</Project>
